# Database - Neon PostgreSQL
DATABASE_URL=postgresql://username:password@host/database?sslmode=require&channel_binding=require&connect_timeout=30&pool_timeout=30

# Clerk Authentication
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_your_publishable_key_here
CLERK_SECRET_KEY=sk_test_your_secret_key_here
CLERK_WEBHOOK_SECRET=whsec_your_webhook_secret_here
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/dashboard
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/dashboard

# Rate Limiting (Upstash Redis) - Optional for development
UPSTASH_REDIS_REST_URL=https://your-redis-instance.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_redis_token_here

# Application
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development

# Debug logging (set to "true" to enable detailed logs)
DEBUG=
