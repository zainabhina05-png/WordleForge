# Database - Neon PostgreSQL
DATABASE_URL=postgresql://username:password@host/database?sslmode=require&channel_binding=require&connect_timeout=30&pool_timeout=30

# Clerk Authentication
# Use pk_live_* and sk_live_* keys in production (from Clerk dashboard)
# Use pk_test_* and sk_test_* keys for development only
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_live_your_live_publishable_key_here
CLERK_SECRET_KEY=sk_live_your_live_secret_key_here
CLERK_WEBHOOK_SECRET=whsec_your_webhook_secret_here
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/dashboard
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/dashboard

# Rate Limiting (Upstash Redis) - Optional for development
UPSTASH_REDIS_REST_URL=https://your-redis-instance.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_redis_token_here

# Application
# Local development: http://localhost:3000
# Vercel production: https://your-project.vercel.app (or your custom domain)
# NOTE: Always include the protocol (http:// or https://)
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development

# Debug logging (set to "true" to enable detailed logs)
DEBUG=
